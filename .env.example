# Copy to .env and fill in. The Taskfile loads .env for every task; the server
# itself reads only the process environment. Shell variables and Taskfile env
# win over this file.

# HTTP server
# HOST=localhost
# PORT=6930
# DB_PATH=./data/sqlite.db
# DB_MIGRATE_ON_START=true
# With both set the server speaks TLS and browsers get HTTP/2, so every open
# tab's live stream shares one connection. Without them it serves HTTP/1.1,
# plus h2c for a proxy that terminates TLS in front of it.
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Model provider. These values match `task dev.deepseek`.
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENAI_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=
# "none" turns reasoning off; "max" is the highest effort.
OPENAI_REASONING_EFFORT=low
# OPENAI_SESSION_ID=

# Mutation budget
# MUTATION_ROUNDS=16384
# MAX_MUTATIONS_PER_DAY=500

# Admin panel. Generated and logged when empty.
# ADMIN_TOKEN=
# The admin pages answer only on this port, so their login cookie lives on an
# origin the board's JavaScript never runs on. The board's port redirects
# /admin here, keeping the host, so LAN addresses work. Defaults to the port
# after PORT, skipping the live reload proxy.
# ADMIN_PORT=6932
