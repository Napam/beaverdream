package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/Napam/beaverdream"
	"github.com/Napam/beaverdream/db/generated/sqlc"
	"github.com/Napam/beaverdream/lib/webmaster"
)

// RunView pairs a stored run with its parsed conversation, so the admin
// template never touches JSON.
type RunView struct {
	Run            sqlc.ListWebmasterTurnsRow
	Messages       []webmaster.Message
	MessagesLoaded bool
}

// FeedView is one declared journal key: the match being played, its rules and
// size, and the last rows the page would fold.
type FeedView struct {
	Key   string
	Match int
	Rules int
	Rows  int
	Last  []webmaster.JournalTailRow
}

// StateView is one value in the model-declared shared state.
type StateView struct {
	Key   string
	Value string
}

const (
	adminCard  = "rounded-sm border border-gray-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
	adminLabel = "mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-neutral-500"
	adminPre   = "overflow-auto rounded bg-gray-50 p-3 font-mono text-xs whitespace-pre-wrap text-gray-600 dark:bg-neutral-950 dark:text-neutral-400"
	adminInput = "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 placeholder:text-gray-400 focus:border-gray-500 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-200 dark:placeholder:text-neutral-600 dark:focus:border-neutral-600"
)

func statusClass(status string) string {
	switch status {
	case "changed":
		return "text-emerald-600 dark:text-emerald-400"
	case "error":
		return "text-red-600 dark:text-red-400"
	default:
		return "text-gray-500 dark:text-neutral-400"
	}
}

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// feedText prints the last rows of a match in the shape the page's reducer
// sees them, one per line.
func feedText(rows []webmaster.JournalTailRow) string {
	lines := make([]string, 0, len(rows))
	for _, row := range rows {
		lines = append(lines, fmt.Sprintf("#%d %s %s", row.ID, row.Visitor, row.Payload))
	}
	return strings.Join(lines, "\n")
}

func rowCount(n int) string {
	if n == 1 {
		return "1 row"
	}
	return strconv.Itoa(n) + " rows"
}

func stateText(states []StateView) string {
	lines := make([]string, 0, len(states))
	for _, state := range states {
		lines = append(lines, state.Key+" = "+state.Value)
	}
	return strings.Join(lines, "\n")
}

// AdminPage shows the current render, the full conversation behind every
// mutation, and a box for talking to the model directly.
templ AdminPage(site sqlc.SiteVersion, feeds []FeedView, states []StateView, runs []RunView, versions []sqlc.SiteVersion, summary string, summaryThrough int64, flash string, token string) {
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>beaverdream admin</title>
			<link rel="icon" type="image/svg+xml" href={ beaverdream.StaticRootPath("static/assets/beaver.svg") }/>
			<link rel="stylesheet" id="tailwindcss" href={ beaverdream.StaticRootPath("static/tailwind.css") }/>
		</head>
		<body class="min-h-dvh bg-gray-100 text-gray-800 dark:bg-neutral-950 dark:text-neutral-300">
			<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-4 py-8">
				<header class="flex items-baseline justify-between gap-4">
					<h1 class="text-lg font-semibold tracking-tight text-gray-900 dark:text-neutral-100">beaverdream admin</h1>
					<nav class="flex gap-4 text-xs text-gray-400 dark:text-neutral-600">
						<a class="hover:text-gray-600 dark:hover:text-neutral-400" href="/">board</a>
					</nav>
				</header>
				if flash != "" {
					<p class="rounded-sm border border-emerald-500/40 bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300">{ flash }</p>
				}
				<section class={ adminCard } data-admin-status="1" data-token={ token }>
					<p class={ adminLabel }>live</p>
					<div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-500 dark:text-neutral-400">
						<span>state <span data-live-state class="font-mono text-gray-900 dark:text-neutral-100">idle</span></span>
						<span>version <span data-live-version class="font-mono text-gray-900 dark:text-neutral-100">v{ strconv.FormatInt(site.ID, 10) }</span></span>
						<span>queued <span data-live-pending class="font-mono text-gray-900 dark:text-neutral-100">0</span></span>
						<span>today <span data-live-today class="font-mono text-gray-900 dark:text-neutral-100">…</span></span>
					</div>
					<p data-live-detail class="mt-1 text-xs text-gray-500 dark:text-neutral-400">waiting for a post</p>
					<p data-live-error class="mt-1 text-xs text-red-600 dark:text-red-400"></p>
					<script>
						(function () {
							var card = document.querySelector("[data-admin-status]");
							if (!card) return;
							var token = card.getAttribute("data-token");
							var state = card.querySelector("[data-live-state]");
							var version = card.querySelector("[data-live-version]");
							var pending = card.querySelector("[data-live-pending]");
							var today = card.querySelector("[data-live-today]");
							var detail = card.querySelector("[data-live-detail]");
							var error = card.querySelector("[data-live-error]");
							function tick() {
								if (document.hidden) return;
								fetch("/admin/status?token=" + encodeURIComponent(token), {
									cache: "no-store",
								})
									.then(function (r) {
										return r.json();
									})
									.then(function (d) {
										state.textContent = d.running
											? "running"
											: d.pending > 0
												? "queued"
												: "idle";
										version.textContent = "v" + d.version;
										pending.textContent = String(d.pending || 0);
										today.textContent =
											String(d.today) + (d.cap > 0 ? " / " + d.cap : "");
										if (d.running) {
											detail.textContent =
												d.running.kind +
												" by " +
												(d.running.authors || []).join(", ") +
												" (round " +
												d.running.round +
												")";
										} else {
											detail.textContent = "waiting for a post";
										}
										error.textContent = d.error || "";
									})
									.catch(function () {});
							}
							setInterval(tick, 2000);
							tick();
						})();
					</script>
				</section>
				<section class={ adminCard }>
					<p class={ adminLabel }>compacted memory</p>
					if summary == "" {
						<p class="text-sm text-gray-400 dark:text-neutral-600">nothing compacted yet</p>
					} else {
						<p class="mb-2 text-xs text-gray-400 dark:text-neutral-600">
							one message standing in for turns through #{ strconv.FormatInt(summaryThrough, 10) }
						</p>
						<pre class={ adminPre }>{ summary }</pre>
					}
				</section>
				<section class={ adminCard }>
					<p class={ adminLabel }>current version</p>
					<p class="text-sm">
						<span class="font-mono">v{ strconv.FormatInt(site.ID, 10) }</span>
						<span class="text-gray-400 dark:text-neutral-600">· { site.CreatedAt }</span>
					</p>
					<p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">{ dash(site.Reason) }</p>
					<details class="mt-3">
						<summary class="cursor-pointer text-xs text-gray-500 dark:text-neutral-500">css and regions</summary>
						<pre class={ adminPre + " mt-2" }>{ "CSS:\n" + site.Css + "\n\nHEADER:\n" + site.Header + "\n\nBOARD:\n" + site.Board + "\n\nFOOTER:\n" + site.Footer + "\n\nSTATE SCHEMA:\n" + site.StateSchema + "\n\nJOURNAL SCHEMA:\n" + site.JournalSchema }</pre>
					</details>
					<div class="mt-3 flex flex-wrap gap-2">
						<form method="post" action="/admin/undo">
							<input type="hidden" name="token" value={ token }/>
							<button
								type="submit"
								class="cursor-pointer rounded-sm border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
							>undo last change</button>
						</form>
						<form method="post" action="/admin/heal">
							<input type="hidden" name="token" value={ token }/>
							<button
								type="submit"
								class="cursor-pointer rounded-sm border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
							>heal now</button>
						</form>
					</div>
					<p class="mt-2 text-xs text-gray-500 dark:text-neutral-500">
						heal clears the journal and shared state with the page, so a game in progress ends.
					</p>
				</section>
				<section class={ adminCard }>
					<p class={ adminLabel }>journal and shared state</p>
					if len(feeds) == 0 && len(states) == 0 {
						<p class="text-sm text-gray-400 dark:text-neutral-600">nothing declared</p>
					}
					for _, feed := range feeds {
						<div class="mb-3 last:mb-0">
							<p class="text-sm">
								<span class="font-mono">{ feed.Key }</span>
								<span class="text-gray-400 dark:text-neutral-600">· { rowCount(feed.Rows) } · match { strconv.Itoa(feed.Match) } · rules { strconv.Itoa(feed.Rules) }</span>
							</p>
							if len(feed.Last) == 0 {
								<p class="text-xs text-gray-400 dark:text-neutral-600">no rows in this match yet</p>
							} else {
								<pre class={ adminPre + " mt-1" }>{ feedText(feed.Last) }</pre>
							}
						</div>
					}
					if len(states) > 0 {
						<p class="mt-3 mb-1 text-xs text-gray-400 dark:text-neutral-600">shared state</p>
						<pre class={ adminPre }>{ stateText(states) }</pre>
					}
				</section>
				<section class={ adminCard }>
					<p class={ adminLabel }>talk to the webmaster</p>
					<form method="post" action="/admin/mutate" class="flex flex-col gap-2">
						<input type="hidden" name="token" value={ token }/>
						<textarea
							name="instruction"
							rows="3"
							required
							maxlength="2000"
							placeholder="make it look like a 1998 guestbook"
							class={ adminInput }
						></textarea>
						<div class="flex items-center justify-between gap-4">
							<label class="flex items-center gap-2 text-xs text-gray-500 dark:text-neutral-400">
								<input type="checkbox" name="also_post" value="1"/>
								also store as a post
							</label>
							<button
								type="submit"
								class="cursor-pointer rounded-sm bg-gray-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-black dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
							>send to model</button>
						</div>
					</form>
				</section>
				<section>
					<p class={ adminLabel }>versions</p>
					<table class="w-full text-sm">
						<thead>
							<tr class="text-left text-xs text-gray-400 dark:text-neutral-600">
								<th class="pb-1 font-normal">id</th>
								<th class="pb-1 font-normal">when</th>
								<th class="pb-1 font-normal">reason</th>
								<th class="pb-1"></th>
							</tr>
						</thead>
						<tbody>
							for _, version := range versions {
								<tr class="border-t border-gray-200 dark:border-neutral-800">
									<td class="py-1 font-mono text-xs">v{ strconv.FormatInt(version.ID, 10) }</td>
									<td class="py-1 font-mono text-xs text-gray-400 dark:text-neutral-600">{ version.CreatedAt }</td>
									<td class="py-1 text-xs text-gray-500 dark:text-neutral-400">{ dash(version.Reason) }</td>
									<td class="py-1 text-right">
										if version.ID != site.ID {
											<form method="post" action={ "/admin/versions/" + strconv.FormatInt(version.ID, 10) + "/restore" }>
												<input type="hidden" name="token" value={ token }/>
												<button
													type="submit"
													title="restores this version's page and journal schema; newer feed rows stay but become invisible"
													class="cursor-pointer text-xs text-gray-400 underline-offset-2 hover:underline dark:text-neutral-500"
												>restore</button>
											</form>
										} else {
											<span class="text-xs text-gray-300 dark:text-neutral-700">current</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</section>
				<section>
					<p class={ adminLabel }>mutation history</p>
					if len(runs) == 0 {
						<p class="text-sm text-gray-400 dark:text-neutral-600">nothing yet</p>
					}
					for _, view := range runs {
						@runCard(view)
					}
				</section>
				<section class={ adminCard + " border-red-500/30" }>
					<p class={ adminLabel }>reset</p>
					<form
						method="post"
						action="/admin/reset"
						onsubmit="return confirm('Delete every post, feed row, shared value and later version, and clear the mutation history? This cannot be undone.')"
					>
						<input type="hidden" name="token" value={ token }/>
						<button
							type="submit"
							class="cursor-pointer rounded-sm border border-red-500/40 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/30"
						>reset the board</button>
					</form>
					<p class="mt-2 text-xs text-gray-500 dark:text-neutral-500">
						Deletes every post, feed row, shared value and later version, and clears the mutation history. The original version stays.
					</p>
				</section>
			</div>
		</body>
	</html>
}

templ runCard(view RunView) {
	<details class={ adminCard + " mb-2" }>
		<summary class="cursor-pointer list-none">
			<div class="flex flex-wrap items-baseline gap-2 text-sm">
				<span class="font-mono text-xs text-gray-400 dark:text-neutral-600">#{ strconv.FormatInt(view.Run.ID, 10) }</span>
				<span class="font-medium">{ view.Run.Kind }</span>
				<span class={ "text-xs " + statusClass(view.Run.Status) }>{ view.Run.Status }</span>
				if view.Run.VersionID.Valid {
					<span class="font-mono text-xs text-gray-400 dark:text-neutral-600">v{ strconv.FormatInt(view.Run.VersionID.Int64, 10) }</span>
				}
				<span class="text-xs text-gray-400 dark:text-neutral-600">{ strconv.FormatInt(view.Run.DurationMs, 10) }ms</span>
			</div>
			<div class="mt-1 text-xs text-gray-500 dark:text-neutral-400">{ dash(view.Run.Said) }</div>
			if view.Run.Changes != "" {
				<div class="mt-1 text-xs text-gray-400 dark:text-neutral-600">changed: { view.Run.Changes }</div>
			}
			<div class="mt-1 truncate text-xs text-gray-400 dark:text-neutral-600">{ dash(view.Run.Body) }</div>
		</summary>
		<div class="mt-3 flex flex-col gap-3">
			if view.Run.ErrorText != "" {
				<pre class={ adminPre + " text-red-600 dark:text-red-400" }>{ view.Run.ErrorText }</pre>
			}
			if view.MessagesLoaded {
				for _, message := range view.Messages {
					@messageBlock(message)
				}
			} else {
				<p class="text-xs text-gray-400 dark:text-neutral-600">conversation not loaded for older runs</p>
			}
		</div>
	</details>
}

templ messageBlock(message webmaster.Message) {
	<div class="border-l-2 border-gray-200 pl-3 dark:border-neutral-800">
		<div class="flex items-baseline gap-2 text-xs">
			<span class="font-mono font-semibold text-gray-500 uppercase dark:text-neutral-400">{ message.Role }</span>
			if message.ToolCallID != "" {
				<span class="font-mono text-gray-400 dark:text-neutral-600">{ message.ToolCallID }</span>
			}
		</div>
		if message.Reasoning != "" {
			<details class="mt-1">
				<summary class="cursor-pointer text-xs text-gray-400 dark:text-neutral-600">reasoning</summary>
				<pre class={ adminPre + " mt-1" }>{ message.Reasoning }</pre>
			</details>
		}
		if message.Content != "" {
			<pre class={ adminPre + " mt-1" }>{ message.Content }</pre>
		}
		for _, call := range message.ToolCalls {
			<div class="mt-2">
				<div class="flex items-baseline gap-2 text-xs">
					<span class="font-mono text-emerald-600 dark:text-emerald-400">{ call.Name }</span>
					if call.ID != "" {
						<span class="font-mono text-gray-400 dark:text-neutral-600">{ call.ID }</span>
					}
				</div>
				<pre class={ adminPre + " mt-1" }>{ call.Arguments }</pre>
				if call.Result != "" {
					<pre class={ adminPre + " mt-1" }>{ "→ " + call.Result }</pre>
				}
			</div>
		}
	</div>
}
