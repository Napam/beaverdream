package pages

import (
	"fmt"
	"strconv"
	"strings"
	"unicode/utf8"

	"github.com/Napam/beaverdream"
	"github.com/Napam/beaverdream/db/generated/sqlc"
	"github.com/Napam/beaverdream/lib/webmaster"
)

// resetConfirm asks before the one destructive action. Both the plain form and
// the Datastar click ask the same question.
const resetConfirm = "confirm('Delete every post, feed row, shared value and later version, and clear the mutation history? This cannot be undone.')"

// FeedView is one declared journal key: the match being played, its rules and
// size, and the last rows the page would fold.
type FeedView struct {
	Key   string
	Match int
	Rules int
	Rows  int
	Last  []webmaster.JournalTailRow
}

// StateView is one value in the model-declared shared state.
type StateView struct {
	Key   string
	Value string
}

// LiveView is the admin card's snapshot of the worker right now. It is built
// on the server and patched into the page as the topics change.
type LiveView struct {
	State   string
	Version int64
	Pending int
	Today   int64
	Detail  string
	Error   string
}

const (
	adminCard   = "rounded-lg border border-gray-200 bg-white p-4 shadow-xs dark:border-neutral-800 dark:bg-neutral-900"
	adminLabel  = "text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-neutral-500"
	adminMuted  = "text-xs text-gray-500 dark:text-neutral-500"
	adminPre    = "overflow-auto rounded-md bg-gray-50 p-3 font-mono text-xs leading-relaxed whitespace-pre-wrap break-words text-gray-700 dark:bg-neutral-950 dark:text-neutral-300"
	adminInput  = "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 placeholder:text-gray-400 focus:border-gray-500 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-200 dark:placeholder:text-neutral-600 dark:focus:border-neutral-600"
	adminButton = "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 disabled:cursor-default disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
	adminChip   = "inline-flex items-center gap-1 rounded-md bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-700 dark:bg-neutral-800 dark:text-neutral-300"
	// historyGrid is one set of column tracks for the turns list's header and
	// every row, so a status badge or a missing version cannot shift the
	// columns behind it.
	historyGrid = "grid grid-cols-[2.25rem_4.25rem_4.5rem_minmax(0,1fr)_2.5rem_3.5rem_3rem] items-center gap-x-3"
)

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// feedText prints the last rows of a match in the shape the page's reducer
// sees them, one per line.
func feedText(rows []webmaster.JournalTailRow) string {
	lines := make([]string, 0, len(rows))
	for _, row := range rows {
		lines = append(lines, fmt.Sprintf("#%d %s %s", row.ID, row.Visitor, row.Payload))
	}
	return strings.Join(lines, "\n")
}

func rowCount(n int) string {
	if n == 1 {
		return "1 row"
	}
	return strconv.Itoa(n) + " rows"
}

func stateText(states []StateView) string {
	lines := make([]string, 0, len(states))
	for _, state := range states {
		lines = append(lines, state.Key+" = "+state.Value)
	}
	return strings.Join(lines, "\n")
}

// todayText is the number of mutations so far today.
func todayText(live LiveView) string {
	return strconv.FormatInt(live.Today, 10)
}

func liveDot(state string) string {
	switch state {
	case "running":
		return "bg-indigo-500 animate-pulse"
	case "queued":
		return "bg-amber-400"
	}
	return "bg-emerald-500"
}

func height(part, whole int64) string {
	return "height: " + percent(part, whole)
}

func width(part, whole int64) string {
	return "width: " + percent(part, whole)
}

// The admin pages. Each one has its own path, and the panel links between them
// with a fetch that carries the remembered login as a cookie.
const (
	PageOverview = "overview"
	PageTurns    = "turns"
	PageSite     = "site"
)

// Panel names one admin page. Turn is the turn the turns page shows, or 0 to
// follow the newest.
type Panel struct {
	Page string
	Turn int64
	// Live is true when the render showed a turn still in flight, so the
	// stream patches the inspector once even if the turn lands first.
	Live bool
}

// Path is where the page lives. A login form posts back to it, so a reload
// returns to the same page.
func (p Panel) Path() string {
	switch {
	case p.Page == PageTurns && p.Turn > 0:
		return "/admin/turns/" + i64(p.Turn)
	case p.Page == PageTurns:
		return "/admin/turns"
	case p.Page == PageSite:
		return "/admin/site"
	}
	return "/admin"
}

// LivePath is the page's stream. It names the page, so the stream pushes only
// the panels this page shows.
func (p Panel) LivePath() string {
	path := "/admin/live?page=" + p.Page
	if p.Turn > 0 {
		path += "&turn=" + i64(p.Turn)
	}
	if p.Live {
		path += "&live=1"
	}
	return path
}

// AdminView is everything one admin page shows. A field another page needs
// stays empty. The page and the in-place patch after an action or a
// navigation render from the same value, so nothing redirects and no secret
// lands in a URL.
type AdminView struct {
	Panel          Panel
	Site           sqlc.SiteVersion
	Live           LiveView
	Feeds          []FeedView
	States         []StateView
	Turns          []TurnRow
	Turn           *TurnDetail
	Metrics        MetricsView
	Budget         BudgetView
	Versions       []sqlc.SiteVersion
	Summary        string
	SummaryThrough int64
	Flash          string
	// CSRF is the token every action form carries for this login. Empty when
	// the request has no login cookie, which is why login redirects.
	CSRF string
	// Board is the board's URL as seen from the admin port, for the header
	// link. The admin runs on its own port, so a relative link would 404.
	Board string
	// Stream is the data-init that opens this page's stream.
	Stream string
	// Run is the turn in flight, for the inspector to show before the
	// conversation is stored. Nil when nothing runs.
	Run *RunProgress
	// Queue is the posts waiting for the next turn, shown above the turns as
	// one row with status "queued".
	Queue QueueView
}

// adminSignals are the page's local signals: which code tab of the current
// version is open. The login cookie rides along with the fetches, so there is
// no secret to keep here.
func adminSignals() string {
	return "{_code: 'html'}"
}

// fetchPage loads an admin page into #admin-body.
func fetchPage(path string) string {
	return "@get('" + path + "')"
}

// navTo follows a link inside the panel: push the path, fetch the page. A
// modified click falls through to the browser, so a new tab works and asks
// for the password there.
func navTo(path string) string {
	return "if (!evt.metaKey && !evt.ctrlKey && !evt.shiftKey && !evt.altKey) { " +
		"evt.preventDefault(); history.pushState(null, '', '" + path + "'); " +
		fetchPage(path) + "; window.scrollTo(0, 0) }"
}

// AdminLogin is the only thing an unauthenticated visitor sees: a password
// box. A correct password sets the login cookie, good for 30 days; the form
// posts to the page it was asked for, so a reload, a new tab or a link from
// someone else lands where it was going.
templ AdminLogin(action string, failed bool) {
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>beaverdream admin</title>
			<link rel="icon" type="image/svg+xml" href={ beaverdream.StaticRootPath("static/assets/beaver.svg") }/>
			<link rel="stylesheet" id="tailwindcss" href={ beaverdream.StaticRootPath("static/tailwind.css") }/>
			@themeScript()
		</head>
		<body class="min-h-dvh bg-gray-100 text-gray-800 dark:bg-neutral-950 dark:text-neutral-300">
			<main class="mx-auto flex min-h-dvh w-full max-w-sm flex-col justify-center gap-4 px-4">
				<h1 class="text-lg font-semibold tracking-tight text-gray-900 dark:text-neutral-100">beaverdream admin</h1>
				<form method="post" action={ templ.SafeURL(action) } class="flex flex-col gap-2">
					<label class="text-xs text-gray-500 dark:text-neutral-400" for="password">password</label>
					<input
						id="password"
						type="password"
						name="password"
						autocomplete="current-password"
						autofocus
						required
						class={ adminInput }
					/>
					if failed {
						<p class="text-sm text-red-600 dark:text-red-400">wrong password</p>
					}
					<button
						type="submit"
						class="cursor-pointer rounded-md bg-gray-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-black dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
					>enter</button>
					<p class="text-xs text-gray-400 dark:text-neutral-500">signing in needs cookies; without them every visit asks again</p>
				</form>
			</main>
		</body>
	</html>
}

// AdminPage is the shell. Back and forward fetch the page the address bar
// names; everything else lives in AdminBody, which navigation replaces.
templ AdminPage(view AdminView, datastar string) {
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>beaverdream admin</title>
			<link rel="icon" type="image/svg+xml" href={ beaverdream.StaticRootPath("static/assets/beaver.svg") }/>
			<link rel="stylesheet" id="tailwindcss" href={ beaverdream.StaticRootPath("static/tailwind.css") }/>
			@themeScript()
			<script type="module" src={ datastar }></script>
		</head>
		<body class="min-h-dvh bg-gray-100 text-gray-800 antialiased dark:bg-neutral-950 dark:text-neutral-300">
			<div
				class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6"
				data-signals={ adminSignals() }
				data-on:popstate__window="@get(location.pathname)"
			>
				@AdminBody(view)
			</div>
		</body>
	</html>
}

// AdminBody is one page without the shell. Navigation and actions patch this
// whole element. The stream mount is inside it with an id per page, so a new
// page closes the old stream and opens its own.
templ AdminBody(view AdminView) {
	<div id="admin-body" class="flex flex-col gap-6">
		<div id={ "admin-stream-" + view.Panel.Page + "-" + i64(view.Panel.Turn) } hidden data-init={ view.Stream }></div>
		<header class="sticky top-0 z-20 -mx-4 bg-gray-100/90 backdrop-blur sm:-mx-6 dark:bg-neutral-950/90">
			<div class="flex min-h-14 flex-wrap items-center gap-x-6 gap-y-1 px-4 sm:px-6">
				<h1 class="shrink-0 text-base font-semibold tracking-tight text-gray-900 dark:text-neutral-100">beaverdream admin</h1>
				<nav class="flex shrink-0 gap-1 self-stretch text-sm">
					@navLink(view.Panel, PageOverview, "/admin", "overview")
					@navLink(view.Panel, PageTurns, "/admin/turns", "turns")
					@navLink(view.Panel, PageSite, "/admin/site", "site")
				</nav>
				<div class="ml-auto flex items-center gap-1.5">
					@themeToggle()
					<a class="rounded-sm px-2 py-1.5 text-sm text-gray-500 hover:bg-gray-200/70 hover:text-gray-900 dark:text-neutral-500 dark:hover:bg-neutral-800/70 dark:hover:text-neutral-200" href={ view.Board } target="_blank" rel="noopener">board ↗</a>
					<form method="post" action="/admin/logout" class="contents">
						@csrfInput(view.CSRF)
						<button type="submit" class="cursor-pointer rounded-sm px-2 py-1.5 text-sm text-gray-500 hover:bg-gray-200/70 hover:text-gray-900 dark:text-neutral-500 dark:hover:bg-neutral-800/70 dark:hover:text-neutral-200">sign out</button>
					</form>
				</div>
			</div>
			<div class="px-4 sm:px-6">
				<div class="flex h-8 items-center border-y border-gray-200 dark:border-neutral-800">
					@AdminLiveCard(view.Live)
				</div>
			</div>
		</header>
		<div id="admin-flash" class="empty:hidden">
			if view.Flash != "" {
				<p class="rounded-md border border-emerald-500/40 bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300">{ view.Flash }</p>
			}
		</div>
		switch view.Panel.Page {
			case PageTurns:
				@turnsPage(view)
			case PageSite:
				@sitePage(view)
			default:
				@overviewPage(view)
		}
	</div>
}

func navClass(current Panel, page string) string {
	base := "flex items-center border-b-2 px-3 "
	if current.Page == page {
		return base + "border-gray-900 font-medium text-gray-900 dark:border-neutral-100 dark:text-neutral-100"
	}
	return base + "border-transparent text-gray-500 hover:text-gray-900 dark:text-neutral-500 dark:hover:text-neutral-200"
}

templ navLink(current Panel, page string, path string, label string) {
	<a href={ templ.SafeURL(path) } data-on:click={ navTo(path) } class={ navClass(current, page) }>{ label }</a>
}

// overviewPage is the glance, top to bottom: talk to the webmaster, how
// recent turns went, how close the room is to compaction, and what it
// remembers.
templ overviewPage(view AdminView) {
	<div class="flex flex-col gap-6">
		@adminInstruct(view.CSRF)
		@AdminMetrics(view.Metrics)
		@AdminBudget(view.Budget)
		@AdminMemory(view.Summary, view.SummaryThrough)
	</div>
}

// turnsPage shows the list of recent turns, then one of them: the newest or
// the one in the URL.
templ turnsPage(view AdminView) {
	{{ older, newer := view.turnNeighbours() }}
	<div class="flex flex-col gap-3">
		@AdminHistory(view.Turns, view.Panel.Turn, view.Queue)
		@AdminTurn(view.Turn, view.Panel.Turn == 0, older, newer, view.Run, view.CSRF)
	</div>
}

// sitePage is the page as it stands, the versions before it, the data it
// keeps, and the destructive action, top to bottom.
templ sitePage(view AdminView) {
	<div class="flex flex-col gap-6">
		@AdminVersion(view.Site, view.CSRF)
		@AdminVersions(view.Versions, view.Site.ID, view.CSRF)
		@AdminFeeds(view.Feeds, view.States)
	</div>
	<section class={ adminCard + " border-red-500/30 dark:border-red-500/30" }>
		<p class={ adminLabel }>danger zone</p>
		<div class="mt-2 flex flex-wrap items-center gap-4">
			<form
				method="post"
				action="/admin/reset"
				onsubmit={ templ.JSUnsafeFuncCall("return " + resetConfirm) }
			>
				@csrfInput(view.CSRF)
				<button
					type="submit"
					data-indicator:_resetting
					data-attr:disabled="$_resetting"
					data-on:click={ "evt.preventDefault(); if (" + resetConfirm + ") @post('/admin/reset', {contentType: 'form'})" }
					class="cursor-pointer rounded-md border border-red-500/40 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50 disabled:cursor-default disabled:opacity-50 dark:text-red-400 dark:hover:bg-red-950/30"
				>reset the board</button>
			</form>
			<p class={ adminMuted }>
				Deletes every post, feed row, shared value and later version, and clears the mutation history. The original version stays.
			</p>
		</div>
	</section>
}

templ adminInstruct(csrf string) {
	<section class={ adminCard }>
		<p class={ adminLabel }>talk to the webmaster</p>
		<form method="post" action="/admin/mutate" class="mt-2 flex flex-col gap-2" data-on:submit="@post('/admin/mutate', {contentType: 'form'})" data-indicator:_sending>
			@csrfInput(csrf)
			<textarea
				name="instruction"
				rows="3"
				required
				maxlength="2000"
				placeholder="make it look like a 1998 guestbook"
				class={ adminInput }
			></textarea>
			<div class="flex items-center justify-between gap-4">
				<label class="flex items-center gap-2 text-xs text-gray-500 dark:text-neutral-400">
					<input type="checkbox" name="also_post" value="1"/>
					also store as a post
				</label>
				<button
					type="submit"
					data-attr:disabled="$_sending"
					class="cursor-pointer rounded-md bg-gray-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-black disabled:cursor-default disabled:opacity-50 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
				>send to model</button>
			</div>
		</form>
	</section>
}

// AdminLiveCard is the worker's state right now, in the sticky header. The
// stream patches the whole element, so every value is server-rendered.
templ AdminLiveCard(live LiveView) {
	<div id="admin-live" class="flex h-full min-w-0 items-center gap-x-4 overflow-hidden text-xs">
		<span class="inline-flex w-64 min-w-0 items-center gap-1.5 rounded-full border border-gray-200 bg-white px-2.5 py-0.5 dark:border-neutral-800 dark:bg-neutral-900" title={ live.Detail }>
			<span class={ "size-2 shrink-0 rounded-full " + liveDot(live.State) }></span>
			<span class="shrink-0 font-medium text-gray-900 dark:text-neutral-100">{ live.State }</span>
			<span class="truncate text-gray-500 dark:text-neutral-400">{ live.Detail }</span>
		</span>
		<span class="shrink-0 text-gray-500 dark:text-neutral-400">version <span class="font-mono text-gray-900 dark:text-neutral-100">v{ i64(live.Version) }</span></span>
		<span class="shrink-0 text-gray-500 dark:text-neutral-400">queued <span class="font-mono text-gray-900 dark:text-neutral-100">{ itoa(live.Pending) }</span></span>
		<span class="shrink-0 text-gray-500 dark:text-neutral-400">today <span class="font-mono text-gray-900 dark:text-neutral-100">{ todayText(live) }</span></span>
		if live.Error != "" {
			<span class="min-w-0 truncate text-red-600 dark:text-red-400" title={ live.Error }>{ live.Error }</span>
		}
	</div>
}

// AdminMetrics charts the recent finished turns: what each one cost in tokens
// and how long it took. A column opens its turn in the inspector.
templ AdminMetrics(m MetricsView) {
	<section id="admin-metrics" class={ adminCard + " flex flex-col gap-5" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class={ adminLabel }>recent turns</p>
			<p class={ adminMuted }>last { plural(m.Finished, "finished turn") }</p>
		</div>
		if m.Finished == 0 {
			<p class="text-sm text-gray-400 dark:text-neutral-600">no finished turns yet</p>
		} else {
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
				@statTile("avg time", millis(m.TotalMs/int64(m.Finished)), "per turn")
				@statTile("avg rounds", strconv.FormatFloat(float64(m.TotalRounds)/float64(m.Finished), 'f', 1, 64), "most "+itoa(m.MaxRoundsCount))
				@statTile("cache hit", ratio(m.CachedTokens, m.PromptTokens), "of prompt tokens")
				@statTile("tokens in", short(m.PromptTokens), short(m.PromptTokens-m.CachedTokens)+" uncached")
				@statTile("tokens out", short(m.OutputTokens), "incl. reasoning")
				@statTile("rejected", itoa(m.RejectedCalls), "tool calls")
			</div>
			<div class="flex flex-col gap-1.5">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<p class="text-sm font-medium text-gray-900 dark:text-neutral-100">tokens per turn</p>
					<div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-neutral-400">
						@legend("bg-sky-200 dark:bg-sky-900", "prompt, cached")
						@legend("bg-sky-500", "prompt, uncached")
						@legend("bg-violet-500", "output")
					</div>
				</div>
				if m.MaxTokens == 0 {
					<p class="flex h-36 items-center justify-center rounded-md bg-gray-50 text-sm text-gray-400 dark:bg-neutral-950 dark:text-neutral-600">the model reported no token counts</p>
				}
				<div
					class="flex h-36 items-end gap-0.5 border-b border-gray-200 dark:border-neutral-800"
					if m.MaxTokens == 0 {
						hidden
					}
				>
					for _, row := range m.Turns {
						<a
							href={ templ.SafeURL(turnPath(row.Run.ID, row.Run.ID == m.NewestTurnID)) }
							title={ turnTitle(row) }
							data-on:click={ navTo(turnPath(row.Run.ID, row.Run.ID == m.NewestTurnID)) }
							class="flex h-full max-w-16 min-w-0 flex-1 cursor-pointer flex-col justify-end rounded-t-sm hover:bg-gray-100 dark:hover:bg-neutral-800"
						>
							<span class="flex w-full flex-col overflow-hidden rounded-t-sm" style={ height(row.PromptTokens+row.CompletionTokens, m.MaxTokens) }>
								<span class="w-full bg-violet-500" style={ height(row.CompletionTokens, row.PromptTokens+row.CompletionTokens) }></span>
								<span class="w-full bg-sky-500" style={ height(row.PromptTokens-row.CachedTokens, row.PromptTokens+row.CompletionTokens) }></span>
								<span class="w-full bg-sky-200 dark:bg-sky-900" style={ height(row.CachedTokens, row.PromptTokens+row.CompletionTokens) }></span>
							</span>
						</a>
					}
				</div>
				@chartAxis(m, short(m.MaxTokens)+" tokens")
			</div>
			<div class="flex flex-col gap-1.5">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<p class="text-sm font-medium text-gray-900 dark:text-neutral-100">time per turn <span class="font-normal text-gray-500 dark:text-neutral-500">· the number is rounds</span></p>
					<div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-neutral-400">
						@legend(statusBar("changed"), "changed")
						@legend(statusBar("kept"), "kept")
						@legend(statusBar("silent"), "silent")
						@legend(statusBar("error"), "error")
					</div>
				</div>
				<div class="flex h-28 items-end gap-0.5 border-b border-gray-200 dark:border-neutral-800">
					for _, row := range m.Turns {
						<a
							href={ templ.SafeURL(turnPath(row.Run.ID, row.Run.ID == m.NewestTurnID)) }
							title={ turnTitle(row) }
							data-on:click={ navTo(turnPath(row.Run.ID, row.Run.ID == m.NewestTurnID)) }
							class="flex h-full max-w-16 min-w-0 flex-1 cursor-pointer flex-col items-center justify-end rounded-t-sm hover:bg-gray-100 dark:hover:bg-neutral-800"
						>
							<span class="text-[10px] leading-4 text-gray-400 tabular-nums dark:text-neutral-500">{ itoa(row.Rounds) }</span>
							<span class={ "w-full rounded-t-sm " + statusBar(row.Run.Status) } style={ height(row.Run.DurationMs, m.MaxDurationMs) }></span>
						</a>
					}
				</div>
				@chartAxis(m, millis(m.MaxDurationMs))
			</div>
		}
	</section>
}

templ statTile(label string, value string, sub string) {
	<div class="rounded-md bg-gray-50 px-3 py-2 dark:bg-neutral-950">
		<p class="text-[11px] tracking-wide text-gray-500 uppercase dark:text-neutral-500">{ label }</p>
		<p class="font-mono text-lg font-semibold text-gray-900 tabular-nums dark:text-neutral-100">{ value }</p>
		<p class="truncate text-[11px] text-gray-400 dark:text-neutral-600">{ sub }</p>
	</div>
}

templ legend(swatch string, label string) {
	<span class="inline-flex items-center gap-1.5"><span class={ "size-2.5 rounded-sm " + swatch }></span>{ label }</span>
}

templ chartAxis(m MetricsView, top string) {
	<div class="flex justify-between font-mono text-[11px] text-gray-400 dark:text-neutral-600">
		if len(m.Turns) > 0 {
			<span>#{ i64(m.Turns[0].Run.ID) }</span>
			<span>tallest { top }</span>
			<span>#{ i64(m.Turns[len(m.Turns)-1].Run.ID) }</span>
		}
	</div>
}

// AdminBudget shows how close the next prompt is to compaction, measured the
// way the server decides it.
templ AdminBudget(b BudgetView) {
	<section id="admin-budget" class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex items-baseline justify-between gap-2">
			<p class={ adminLabel }>context budget</p>
			<p class={ adminMuted }>compaction runs when either bar fills</p>
		</div>
		<div class="flex flex-col gap-1">
			<div class="flex items-baseline justify-between text-sm">
				<span>log + page</span>
				<span class="font-mono tabular-nums">~{ short(b.Tokens()) } / { short(int64(b.LimitTokens)) } tokens</span>
			</div>
			<div class="flex h-3 overflow-hidden rounded-full bg-gray-100 dark:bg-neutral-800">
				<span class="h-full bg-sky-500" style={ width(b.LogRunes/runesPerToken, int64(b.LimitTokens)) } title={ "room log ~" + short(b.LogRunes/runesPerToken) + " tokens" }></span>
				<span class="h-full bg-emerald-500" style={ width(b.PageRunes/runesPerToken, int64(b.LimitTokens)) } title={ "page ~" + short(b.PageRunes/runesPerToken) + " tokens" }></span>
			</div>
			<div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-neutral-400">
				@legend("bg-sky-500", "room log ~"+short(b.LogRunes/runesPerToken))
				@legend("bg-emerald-500", "page ~"+short(b.PageRunes/runesPerToken))
			</div>
		</div>
		<div class="flex flex-col gap-1">
			<div class="flex items-baseline justify-between text-sm">
				<span>turns since the summary</span>
				<span class="font-mono tabular-nums">{ i64(b.Turns) } / { itoa(b.LimitTurns) }</span>
			</div>
			<div class="h-3 overflow-hidden rounded-full bg-gray-100 dark:bg-neutral-800">
				<span class="block h-full bg-violet-500" style={ width(b.Turns, int64(b.LimitTurns)) }></span>
			</div>
		</div>
		<p class={ adminMuted }>
			if b.SummaryThrough > 0 {
				The summary covers turns through #{ i64(b.SummaryThrough) } and adds ~{ short(b.SummaryRunes / runesPerToken) } tokens on top.
			} else {
				Nothing compacted yet. Every turn so far is in the log.
			}
		</p>
	</section>
}

// AdminMemory is the compacted history. The stream patches it when a run
// ends, so a summary written during compaction shows without a reload.
templ AdminMemory(summary string, through int64) {
	<section id="admin-memory" class={ adminCard }>
		<p class={ adminLabel }>compacted memory</p>
		if summary == "" {
			<p class="mt-2 text-sm text-gray-400 dark:text-neutral-600">nothing compacted yet</p>
		} else {
			<details class="mt-2" data-preserve-attr="open">
				<summary class="cursor-pointer text-sm text-gray-600 dark:text-neutral-400">
					one message standing in for turns through #{ i64(through) } · { tokens(utf8.RuneCountInString(summary)) } tokens
				</summary>
				<pre class={ adminPre + " mt-2 max-h-96" }>{ summary }</pre>
			</details>
		}
	</section>
}

// AdminHistory lists the queued batch and the newest turns as a table, one
// link per turn. The stream patches it when a run ends or a post arrives, so
// a turn appears without a reload. picked is the turn the page shows, or 0
// for the newest.
templ AdminHistory(turns []TurnRow, picked int64, queue QueueView) {
	<section id="admin-history" class={ adminCard + " p-0" }>
		<div class="flex items-baseline justify-between border-b border-gray-200 px-4 py-2.5 dark:border-neutral-800">
			<p class={ adminLabel }>turns</p>
			<p class={ adminMuted }>{ historyCount(len(turns), queue.Posts) }</p>
		</div>
		if len(turns) == 0 && queue.Posts == 0 {
			<p class="px-4 py-3 text-sm text-gray-400 dark:text-neutral-600">nothing yet</p>
		} else {
			<div class="max-h-80 overflow-y-auto">
				<div class={ historyGrid + " sticky top-0 z-10 border-b border-gray-200 bg-white py-1 pr-3 pl-[14px] text-[11px] tracking-wide text-gray-400 uppercase dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500" }>
					<span>#</span>
					<span>status</span>
					<span>who</span>
					<span>answered</span>
					<span>ver</span>
					<span class="text-right">in</span>
					<span class="text-right">time</span>
				</div>
				<ol>
					if queue.Posts > 0 {
						<li>
							<div
								title={ queue.Title }
								class={ historyGrid + " border-l-2 border-transparent px-3 py-1.5 text-sm" }
							>
								<span class="font-mono text-xs text-gray-400 tabular-nums dark:text-neutral-500">next</span>
								<span class="justify-self-start">@statusBadge("queued")</span>
								<span class="truncate text-xs font-medium text-indigo-700 dark:text-indigo-400">{ dash(queue.Authors) }</span>
								<span class="truncate text-gray-900 dark:text-neutral-100">{ dash(oneLine(queue.Text)) }</span>
								<span></span>
								<span></span>
								<span></span>
							</div>
						</li>
					}
					for i, row := range turns {
						<li>
							<a
								href={ templ.SafeURL(turnPath(row.Run.ID, i == 0)) }
								data-on:click={ navTo(turnPath(row.Run.ID, i == 0)) }
								title={ turnTitle(row) }
								class={ historyGrid + " border-l-2 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-neutral-800/60 " + pickedRow(row.Run.ID, picked, i == 0) }
							>
								<span class="font-mono text-xs text-gray-400 tabular-nums dark:text-neutral-500">#{ i64(row.Run.ID) }</span>
								<span class="justify-self-start">@statusBadge(row.Run.Status)</span>
								<span class="truncate text-xs font-medium text-indigo-700 dark:text-indigo-400">{ turnAuthor(row) }</span>
								<span class="truncate text-gray-900 dark:text-neutral-100">{ dash(oneLine(row.Trigger)) }</span>
								<span class="truncate font-mono text-[11px] text-gray-400 dark:text-neutral-500">
									if row.Run.VersionID.Valid {
										v{ i64(row.Run.VersionID.Int64) }
									}
								</span>
								<span class="text-right font-mono text-[11px] text-gray-400 tabular-nums dark:text-neutral-500">
									if row.Rounds > 0 {
										{ short(row.PromptTokens) } in
									}
								</span>
								<span class="text-right font-mono text-[11px] text-gray-400 tabular-nums dark:text-neutral-500">
									if row.Run.Status != "running" {
										{ millis(row.Run.DurationMs) }
									}
								</span>
							</a>
						</li>
					}
				</ol>
			</div>
		}
	</section>
}

// csrfInput is the hidden field every action form carries. The value is
// derived from the login cookie, so the board, which cannot read this page,
// cannot forge an action.
templ csrfInput(token string) {
	<input type="hidden" name="csrf" value={ token }/>
}

// retryTurn runs an errored turn again. The form sits under the error it
// answers, so the action is where the reason is.
templ retryTurn(id int64, csrf string) {
	<form
		method="post"
		action={ "/admin/retry/" + i64(id) }
		data-on:submit={ "@post('/admin/retry/" + i64(id) + "', {contentType: 'form'})" }
		data-indicator:_retrying
	>
		@csrfInput(csrf)
		<button
			type="submit"
			data-attr:disabled="$_retrying"
			title="send this turn's instruction, or the posts it answered, to the model again"
			class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-red-500/30 bg-white px-2.5 py-1 text-xs font-medium text-red-700 hover:border-red-500/60 hover:bg-red-50 disabled:cursor-default disabled:opacity-50 dark:border-red-500/30 dark:bg-neutral-900 dark:text-red-400 dark:hover:border-red-500/60 dark:hover:bg-red-950/30"
		>
			<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"></path><path d="M21 3v6h-6"></path></svg>
			retry
		</button>
	</form>
}

templ statusBadge(status string) {
	<span class={ "rounded-sm px-1.5 py-px text-[11px] font-medium " + statusTone(status) }>{ dash(status) }</span>
}

// AdminTurn is the inspector, with the turns either side of it. Following the
// newest, the stream patches it when a run ends; a picked turn stays as it was
// loaded.
templ AdminTurn(
	detail *TurnDetail,
	following bool,
	older int64,
	newer int64,
	run *RunProgress,
	csrf string,
) {
	<div id="admin-turn">
		if detail == nil {
			<div class={ adminCard }>
				<p class="text-sm text-gray-400 dark:text-neutral-600">No turns yet. Post on the board or talk to the webmaster, and the first turn shows here.</p>
			</div>
		} else {
			<div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-gray-500 dark:text-neutral-500">
				@stepTurn(older, true)
				if following {
					<span>following the newest turn</span>
				} else {
					<span>showing turn #{ i64(detail.Row.Run.ID) }</span>
				}
				@stepTurn(newer, false)
				if !following {
					<a href="/admin/turns" data-on:click={ navTo("/admin/turns") } class="ml-auto text-sky-700 hover:underline dark:text-sky-400">follow the newest</a>
				}
			</div>
			@turnInspector(*detail, run, csrf)
		}
	</div>
}

// stepTurn is one step through the list by id, with a dull arrow at either
// end.
templ stepTurn(id int64, older bool) {
	if id > 0 {
		<a
			href={ templ.SafeURL(turnPath(id, false)) }
			data-on:click={ navTo(turnPath(id, false)) }
			title={ "turn #" + i64(id) }
			class="rounded-sm border border-gray-200 px-1.5 py-0.5 font-mono hover:bg-gray-50 dark:border-neutral-800 dark:hover:bg-neutral-800"
		>
			if older {
				{ "← #" + i64(id) }
			} else {
				{ "#" + i64(id) + " →" }
			}
		</a>
	} else {
		<span class="px-1.5 py-0.5 font-mono text-gray-300 dark:text-neutral-700">
			if older {
				←
			} else {
				→
			}
		</span>
	}
}

templ turnInspector(d TurnDetail, run *RunProgress, csrf string) {
	<div class="flex flex-col gap-4">
		@turnHeader(d, csrf)
		if d.Row.Run.Status == "running" {
			@turnRunning(d, run, csrf)
		} else if !d.Stored {
			<div class={ adminCard }>
				<p class="text-sm text-gray-500 dark:text-neutral-400">No conversation was stored for this turn.</p>
			</div>
		} else {
			@turnContext(d)
			if len(d.Rounds) > 0 {
				@turnGrowth(d)
			}
			for _, round := range d.Rounds {
				@roundCard(round)
			}
		}
	</div>
}

// turnRunning is the inspector before the conversation is stored. It shows
// what the model read, every finished round in full, and the round being
// written as it streams. The stored turn replaces it when the turn lands.
templ turnRunning(d TurnDetail, run *RunProgress, csrf string) {
	if run == nil || run.TurnID != d.Row.Run.ID {
		<div class={ adminCard }>
			<p class="text-sm text-gray-500 dark:text-neutral-400">This turn is still running. Its conversation is stored when it ends.</p>
		</div>
	} else {
		<div class={ adminCard + " flex flex-wrap items-center gap-2" }>
			<span class={ adminLabel }>in flight</span>
			<span class={ adminChip }>round { itoa(run.Round) } with the model</span>
			<span class={ adminChip }>started { run.Since.UTC().Format("Jan 2 15:04:05") } UTC</span>
			<form
				method="post"
				action={ "/admin/stop/" + i64(d.Row.Run.ID) }
				data-on:submit={ "@post('/admin/stop/" + i64(d.Row.Run.ID) + "', {contentType: 'form'})" }
				data-indicator:_stopping
				class="ml-auto"
			>
				@csrfInput(csrf)
				<button type="submit" data-attr:disabled="$_stopping" title="cancel this turn; the page stays as it was and queued posts still run" class={ adminButton }>stop turn</button>
			</form>
		</div>
		if len(d.Context) > 0 {
			@turnContext(d)
		}
		if len(d.Rounds) > 0 {
			@turnGrowth(d)
		}
		for _, round := range d.Rounds {
			@roundCard(round)
		}
		@AdminDraft(run)
	}
}

// AdminDraft is the round the model is writing, patched on its own as chunks
// arrive so a draft never resends the prompt or the finished rounds. Each
// growing block stays pinned to its newest line unless scrolled up.
templ AdminDraft(run *RunProgress) {
	{{ draft := run.LiveDraft() }}
	<div id="admin-draft" class={ adminCard + " flex flex-col gap-3 border-sky-300 dark:border-sky-900" }>
		<div class="flex flex-wrap items-center gap-2">
			<span class="size-2 animate-pulse rounded-full bg-sky-500"></span>
			<span class="font-semibold text-gray-900 dark:text-neutral-100">round { itoa(draft.Round) }</span>
			<span class={ adminChip }>{ draft.Phase }</span>
			<span class={ adminChip }>started { draft.Since.UTC().Format("15:04:05") } UTC</span>
			if !draft.Updated.IsZero() {
				<span class={ adminChip }>last chunk { draft.Updated.UTC().Format("15:04:05") } UTC</span>
			}
		</div>
		if draft.Reasoning != "" {
			<div>
				<p class="text-[11px] tracking-wide text-gray-500 uppercase dark:text-neutral-500">reasoning · { short(int64(utf8.RuneCountInString(draft.Reasoning))) } chars</p>
				@pinned(draft.Reasoning)
			</div>
		}
		if strings.TrimSpace(draft.Content) != "" {
			<div>
				<p class="text-[11px] tracking-wide text-gray-500 uppercase dark:text-neutral-500">reply</p>
				@pinned(draft.Content)
			</div>
		}
		for _, call := range draft.Calls {
			<div class="flex flex-col gap-2 rounded-md border border-sky-300/60 p-3 dark:border-sky-900">
				<div class="flex flex-wrap items-baseline gap-2">
					<span class="font-mono text-sm font-semibold text-gray-900 dark:text-neutral-100">{ call.Name }</span>
					if call.ID != "" {
						<span class="font-mono text-[11px] text-gray-400 dark:text-neutral-600">{ call.ID }</span>
					}
				</div>
				for _, arg := range call.Args {
					if arg.Block {
						<div>
							<p class="font-mono text-[11px] text-gray-500 dark:text-neutral-500">{ arg.Key } · { short(int64(utf8.RuneCountInString(arg.Value))) } chars</p>
							@pinned(arg.Value)
						</div>
					} else {
						<p class="text-sm"><span class="font-mono text-xs text-gray-500 dark:text-neutral-500">{ arg.Key }</span> <span class="font-mono text-xs text-gray-800 dark:text-neutral-200">{ arg.Value }</span></p>
					}
				}
			</div>
		}
	</div>
}

// pinned is a block of growing text. The reversed column keeps its scroll at
// the newest line while text arrives, and leaves it alone once scrolled up.
templ pinned(text string) {
	<div class="mt-1 flex max-h-96 flex-col-reverse overflow-auto rounded-md">
		<pre class={ adminPre + " overflow-visible" }>{ text }</pre>
	</div>
}

templ turnHeader(d TurnDetail, csrf string) {
	<div class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<span class="font-mono text-lg font-semibold text-gray-900 dark:text-neutral-100">#{ i64(d.Row.Run.ID) }</span>
			@statusBadge(d.Row.Run.Status)
			<span class="text-sm text-gray-600 dark:text-neutral-400">{ d.Row.Run.Kind } turn</span>
			if turnAuthor(d.Row) != "" {
				<span class={ adminChip }>{ "for " + turnAuthor(d.Row) }</span>
			}
			if d.Row.Run.VersionID.Valid {
				<span class={ adminChip }>wrote v{ i64(d.Row.Run.VersionID.Int64) }</span>
			}
			<span class="ml-auto font-mono text-xs text-gray-500 dark:text-neutral-500">{ clock(d.Row.Run.CreatedAt) } UTC</span>
		</div>
		<div class="flex flex-wrap gap-2">
			if d.Row.Run.Status != "running" {
				<span class={ adminChip }>{ millis(d.Row.Run.DurationMs) }</span>
			}
			<span class={ adminChip }>{ plural(d.Row.Rounds, "round") }</span>
			<span class={ adminChip }>{ short(d.Row.PromptTokens) } in · { ratio(d.Row.CachedTokens, d.Row.PromptTokens) } cached</span>
			<span class={ adminChip }>{ short(d.Row.CompletionTokens) } out</span>
			if d.Row.Rejected > 0 {
				<span class={ adminChip + " text-red-700 dark:text-red-400" }>{ plural(d.Row.Rejected, "rejected call") }</span>
			}
		</div>
		if d.Row.Run.Status == "running" {
			if d.Row.Trigger != "" {
				@labelled("answered", d.Row.Trigger)
			}
		} else {
			<div class="grid gap-3 md:grid-cols-3">
				@labelled("answered", d.Row.Trigger)
				@labelled("said", d.Row.Run.Said)
				@labelled("changed", d.Row.Run.Changes)
			</div>
		}
		if d.Row.Run.Status == "error" {
			<div class="flex flex-col gap-2">
				if d.Row.Run.ErrorText != "" {
					<pre class={ adminPre + " bg-red-50 text-red-700 dark:bg-red-950/30 dark:text-red-400" }>{ d.Row.Run.ErrorText }</pre>
				}
				<div class="flex justify-end">
					@retryTurn(d.Row.Run.ID, csrf)
				</div>
			</div>
		}
		if d.Row.Run.Notes != "" {
			<details data-preserve-attr="open">
				<summary class="cursor-pointer text-xs text-gray-500 dark:text-neutral-500">notes after this turn · { tokens(utf8.RuneCountInString(d.Row.Run.Notes)) } tokens</summary>
				<pre class={ adminPre + " mt-2 max-h-72" }>{ d.Row.Run.Notes }</pre>
			</details>
		}
	</div>
}

templ labelled(label string, text string) {
	<div class="min-w-0">
		<p class="text-[11px] tracking-wide text-gray-500 uppercase dark:text-neutral-500">{ label }</p>
		<p class="mt-0.5 max-h-32 overflow-auto text-sm whitespace-pre-wrap text-gray-800 dark:text-neutral-200">{ dash(text) }</p>
	</div>
}

// turnContext is what the first request carried, part by part, in the order
// the model read it.
templ turnContext(d TurnDetail) {
	<div class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class={ adminLabel }>what the model read</p>
			<p class="font-mono text-xs text-gray-500 dark:text-neutral-400">{ tokens(d.ContextRunes()) } tokens estimated, a floor: html and scripts run denser · { short(int64(d.ContextRunes())) } chars</p>
		</div>
		<div class="flex h-4 overflow-hidden rounded-md bg-gray-100 dark:bg-neutral-800">
			for _, part := range d.Context {
				<span class={ "h-full border-r border-white/60 last:border-0 dark:border-neutral-900/60 " + partColor(part.Name) } style={ width(int64(part.Runes), int64(d.ContextRunes())) } title={ part.Name + " " + tokens(part.Runes) + " tokens" }></span>
			}
		</div>
		<div class="flex flex-col">
			for _, part := range d.Context {
				@contextRow(part, d.ContextRunes())
			}
		</div>
		if !d.Sectioned {
			<p class={ adminMuted }>This turn was stored before prompt sections were recorded, so the user prompt is one block.</p>
		}
	</div>
}

templ contextRow(part ContextPart, total int) {
	if part.Text == "" {
		<div class="flex items-center gap-3 px-1 py-1.5 text-sm">
			@contextRowLabel(part, total)
		</div>
	} else {
		<details class="group rounded-md open:bg-gray-50 dark:open:bg-neutral-950" data-preserve-attr="open">
			<summary class="flex cursor-pointer list-none items-center gap-3 rounded-md px-1 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-neutral-800/60">
				@contextRowLabel(part, total)
			</summary>
			<pre class={ adminPre + " mx-1 mb-2 max-h-[32rem] bg-white dark:bg-neutral-900" }>{ part.Text }</pre>
		</details>
	}
}

templ contextRowLabel(part ContextPart, total int) {
	<span class={ "size-3 shrink-0 rounded-sm " + partColor(part.Name) }></span>
	<span class="min-w-0 flex-1 truncate text-gray-800 dark:text-neutral-200">
		{ part.Name }
		if part.Note != "" {
			<span class="text-xs text-gray-400 dark:text-neutral-600">{ part.Note }</span>
		}
	</span>
	<span class="hidden h-1.5 w-32 overflow-hidden rounded-full bg-gray-100 sm:block dark:bg-neutral-800">
		<span class={ "block h-full " + partColor(part.Name) } style={ width(int64(part.Runes), int64(total)) }></span>
	</span>
	<span class="w-16 text-right font-mono text-xs text-gray-500 tabular-nums dark:text-neutral-400">{ tokens(part.Runes) }</span>
	<span class="w-12 text-right font-mono text-xs text-gray-400 tabular-nums dark:text-neutral-500">{ ratio(int64(part.Runes), int64(total)) }</span>
	if part.Text != "" {
		<span class="w-4 text-xs text-gray-400 group-open:rotate-90 dark:text-neutral-600">▸</span>
	} else {
		<span class="w-4"></span>
	}
}

// turnGrowth shows each round's request: the same base every time, plus the
// replies and tool results the loop appended before it. The reported numbers
// are what the provider counted.
templ turnGrowth(d TurnDetail) {
	<div class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class={ adminLabel }>how the request grew</p>
			<div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-neutral-400">
				@legend("bg-slate-400", "system, tools and user prompt")
				@legend("bg-indigo-500", "earlier replies and tool results")
			</div>
		</div>
		<div class="flex flex-col gap-1.5">
			for _, round := range d.Rounds {
				<div class="grid grid-cols-[3rem_1fr_auto] items-center gap-3 text-xs">
					<span class="font-mono text-gray-500 dark:text-neutral-400">R{ itoa(round.Stats.Round) }</span>
					<span class="flex h-3 overflow-hidden rounded-sm bg-gray-100 dark:bg-neutral-800">
						<span class="h-full bg-slate-400" style={ width(int64(round.Base), int64(d.MaxInput())) }></span>
						<span class="h-full bg-indigo-500" style={ width(int64(round.Carried), int64(d.MaxInput())) }></span>
					</span>
					<span class="font-mono text-gray-500 tabular-nums dark:text-neutral-400">
						est { tokens(round.Base + round.Carried) }
						if round.Stats.PromptTokens > 0 {
							· sent { short(round.Stats.PromptTokens) } ({ ratio(round.Stats.CachedTokens, round.Stats.PromptTokens) } cached)
						}
					</span>
				</div>
			}
		</div>
		<p class={ adminMuted }>Reasoning goes back with each tool call when the provider returns it, so it counts too.</p>
	</div>
}

templ roundCard(round RoundView) {
	<div class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex flex-wrap items-center gap-2">
			<span class="font-semibold text-gray-900 dark:text-neutral-100">round { itoa(round.Stats.Round) }</span>
			<span class={ adminChip }>{ millis(round.Stats.Elapsed.Milliseconds()) }</span>
			if round.Stats.FirstToken > 0 {
				<span class={ adminChip }>first token { millis(round.Stats.FirstToken.Milliseconds()) }</span>
			}
			<span class={ adminChip }>{ short(round.Stats.PromptTokens) } in · { short(round.Stats.CachedTokens) } cached</span>
			<span class={ adminChip }>{ short(round.Stats.CompletionTokens) } out</span>
			if round.Stats.FinishReason != "" {
				<span class={ adminChip }>finish: { round.Stats.FinishReason }</span>
			}
			if round.Stats.FinishReason == "length" {
				<span class="rounded-sm px-1.5 py-px text-[11px] font-medium bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300">hit the output cap</span>
			}
		</div>
		if round.Stats.Deferred != "" {
			<p class="rounded-md border border-amber-400/40 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:bg-amber-950/30 dark:text-amber-300">done deferred: { round.Stats.Deferred }</p>
		}
		if round.Stats.Resampled {
			<p class="rounded-md border border-rose-400/40 bg-rose-50 px-3 py-2 text-xs text-rose-800 dark:bg-rose-950/30 dark:text-rose-300">resampled: no call in this round had JSON arguments, so the model never saw it</p>
		}
		if round.Stats.Stalled {
			<p class="rounded-md border border-rose-400/40 bg-rose-50 px-3 py-2 text-xs text-rose-800 dark:bg-rose-950/30 dark:text-rose-300">{ stallNote(round.Stats) }</p>
		}
		if round.Stats.Trace != nil {
			@traceBlock(round.Stats)
		}
		if round.Reasoning != "" {
			<details data-preserve-attr="open">
				<summary class="cursor-pointer text-xs text-gray-500 dark:text-neutral-500">reasoning · { short(int64(utf8.RuneCountInString(round.Reasoning))) } chars</summary>
				<pre class={ adminPre + " mt-2 max-h-96" }>{ round.Reasoning }</pre>
			</details>
		}
		if strings.TrimSpace(round.Content) != "" {
			<div>
				<p class="text-[11px] tracking-wide text-gray-500 uppercase dark:text-neutral-500">reply</p>
				<pre class={ adminPre + " mt-1" }>{ round.Content }</pre>
			</div>
		}
		for _, call := range round.Calls {
			@callBlock(call)
		}
	</div>
}

// traceBlock is what the round's stream looked like from the client: the
// backend that answered, the timing, the chunk counts and the raw chunks at
// either end. Raw text lives only here, never in the message bodies.
templ traceBlock(stats webmaster.RoundStats) {
	{{ t := stats.Trace }}
	<details data-preserve-attr="open">
		<summary class="cursor-pointer text-xs text-gray-500 dark:text-neutral-500">stream · { traceSummary(stats) }</summary>
		<div class="mt-2 flex flex-col gap-2">
			<div class="flex flex-wrap gap-2">
				if t.Model != "" {
					<span class={ adminChip }>backend { t.Model }{ fingerprintSuffix(t.Fingerprint) }</span>
				}
				if t.Status > 0 {
					<span class={ adminChip }>{ plural(t.Attempts, "attempt") }, status { itoa(t.Status) }</span>
					<span class={ adminChip }>headers { millis(t.Headers.Milliseconds()) }</span>
				}
				<span class={ adminChip }>first event { millis(t.FirstEvent.Milliseconds()) }</span>
				if t.Name > 0 {
					<span class={ adminChip }>tool name { millis(t.Name.Milliseconds()) }</span>
				}
				<span class={ adminChip }>last event { millis(t.LastEvent.Milliseconds()) }</span>
				<span class={ adminChip }>ended { millis(t.Total.Milliseconds()) }</span>
				<span class={ adminChip }>longest gap { millis(t.LongestGap.Milliseconds()) } while { t.GapPhase }</span>
				<span class={ adminChip }>{ short(t.ReasoningTokens) } reasoning tokens</span>
				if t.PromptRunes > 0 && stats.PromptTokens > 0 {
					<span class={ adminChip }>{ charsPerToken(t.PromptRunes, stats.PromptTokens) } chars per prompt token</span>
				}
			</div>
			<p class="font-mono text-[11px] text-gray-500 dark:text-neutral-500">
				chunks: { itoa(t.Events.Reasoning) } reasoning, { itoa(t.Events.Content) } content, { itoa(t.Events.ToolName) } tool name, { itoa(t.Events.ToolArgs) } tool args, { itoa(t.Events.UsageOnly) } usage, { itoa(t.Events.Empty) } empty
				if t.OtherChoices > 0 || t.FunctionCalls > 0 || len(t.UnknownFields) > 0 {
					· ignored: { itoa(t.OtherChoices) } other choices, { itoa(t.FunctionCalls) } function_call, fields { strings.Join(t.UnknownFields, ", ") }
				}
			</p>
			if len(t.Head) > 0 || len(t.Tail) > 0 {
				<pre class={ adminPre + " max-h-72" }>{ strings.Join(append(append([]string{}, t.Head...), t.Tail...), "\n") }</pre>
			}
		</div>
	</details>
}

func callTone(call CallView) string {
	switch {
	case call.Rejected:
		return "border-red-400/50"
	case call.Deferred:
		return "border-amber-400/50"
	}
	return "border-gray-200 dark:border-neutral-800"
}

func callResultTone(call CallView) string {
	switch {
	case call.Rejected:
		return "bg-red-50 text-red-700 dark:bg-red-950/30 dark:text-red-400"
	case call.Deferred:
		return "bg-amber-50 text-amber-800 dark:bg-amber-950/30 dark:text-amber-300"
	}
	return "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300"
}

templ callBlock(call CallView) {
	<div class={ "flex flex-col gap-2 rounded-md border p-3 " + callTone(call) }>
		<div class="flex flex-wrap items-baseline gap-2">
			<span class="font-mono text-sm font-semibold text-gray-900 dark:text-neutral-100">{ call.Name }</span>
			if call.ID != "" {
				<span class="font-mono text-[11px] text-gray-400 dark:text-neutral-600">{ call.ID }</span>
			}
		</div>
		for _, arg := range call.Args {
			if arg.Block {
				<div>
					<p class="font-mono text-[11px] text-gray-500 dark:text-neutral-500">{ arg.Key } · { short(int64(utf8.RuneCountInString(arg.Value))) } chars</p>
					<pre class={ adminPre + " mt-1 max-h-96" }>{ arg.Value }</pre>
				</div>
			} else {
				<p class="text-sm"><span class="font-mono text-xs text-gray-500 dark:text-neutral-500">{ arg.Key }</span> <span class="font-mono text-xs text-gray-800 dark:text-neutral-200">{ arg.Value }</span></p>
			}
		}
		if call.Result != "" {
			<pre class={ "rounded-md px-3 py-2 font-mono text-xs whitespace-pre-wrap break-words " + callResultTone(call) }>{ "→ " + call.Result }</pre>
		}
	</div>
}

type codeField struct {
	Key   string
	Label string
	Text  string
}

func codeFields(site sqlc.SiteVersion) []codeField {
	return []codeField{
		{"css", "css", site.Css},
		{"html", "html", site.Html},
		{"state", "state schema", site.StateSchema},
		{"journal", "journal schema", site.JournalSchema},
	}
}

// AdminVersion is the current render and the two one-click repairs.
templ AdminVersion(site sqlc.SiteVersion, csrf string) {
	<section id="admin-version" class={ adminCard + " flex flex-col gap-3" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class={ adminLabel }>current version</p>
			<p class="font-mono text-xs text-gray-500 dark:text-neutral-500">{ clock(site.CreatedAt) } UTC</p>
		</div>
		<p class="text-sm">
			<span class="font-mono text-lg font-semibold text-gray-900 dark:text-neutral-100">v{ i64(site.ID) }</span>
			if site.TurnID.Valid {
				<span class="ml-2 font-mono text-xs text-gray-500 dark:text-neutral-500">from turn #{ i64(site.TurnID.Int64) }</span>
			}
		</p>
		<p class="text-sm text-gray-600 dark:text-neutral-400">{ dash(site.Reason) }</p>
		<div class="flex flex-wrap gap-1 border-b border-gray-200 dark:border-neutral-800">
			for _, field := range codeFields(site) {
				<button
					type="button"
					data-on:click={ "$_code = '" + field.Key + "'" }
					data-class={ "{'border-gray-900 text-gray-900 dark:border-neutral-100 dark:text-neutral-100': $_code == '" + field.Key + "'}" }
					class="-mb-px cursor-pointer border-b-2 border-transparent px-2 py-1 text-xs text-gray-500 hover:text-gray-900 dark:text-neutral-500 dark:hover:text-neutral-200"
				>{ field.Label } <span class="font-mono text-[10px] text-gray-400 dark:text-neutral-600">{ short(int64(utf8.RuneCountInString(field.Text))) }</span></button>
			}
		</div>
		for _, field := range codeFields(site) {
			<div
				data-show={ "$_code == '" + field.Key + "'" }
				if field.Key != "html" {
					style="display: none"
				}
			>
				<p class="mb-1 text-[11px] text-gray-400 uppercase dark:text-neutral-600">{ field.Label }</p>
				<pre class={ adminPre + " max-h-96" }>{ dash(field.Text) }</pre>
			</div>
		}
		<div class="flex flex-wrap gap-2">
			<form method="post" action="/admin/undo" data-on:submit="@post('/admin/undo', {contentType: 'form'})" data-indicator:_undoing>
				@csrfInput(csrf)
				<button type="submit" data-attr:disabled="$_undoing" class={ adminButton }>undo last change</button>
			</form>
			<form method="post" action="/admin/heal" data-on:submit="@post('/admin/heal', {contentType: 'form'})" data-indicator:_healing>
				@csrfInput(csrf)
				<button type="submit" data-attr:disabled="$_healing" class={ adminButton }>heal now</button>
			</form>
		</div>
		<p class={ adminMuted }>Heal clears the journal and shared state with the page, so a game in progress ends.</p>
	</section>
}

func versionSize(v sqlc.SiteVersion) int64 {
	return int64(utf8.RuneCountInString(v.Css) + utf8.RuneCountInString(v.Html))
}

func largestVersion(versions []sqlc.SiteVersion) int64 {
	var largest int64
	for _, v := range versions {
		largest = max(largest, versionSize(v))
	}
	return largest
}

// AdminFeeds shows the journal and shared state the page and the prompt see,
// so a stuck feed can be read without opening sqlite.
templ AdminFeeds(feeds []FeedView, states []StateView) {
	<section id="admin-feeds" class={ adminCard + " flex flex-col gap-3" }>
		<p class={ adminLabel }>journal and shared state</p>
		if len(feeds) == 0 && len(states) == 0 {
			<p class="text-sm text-gray-400 dark:text-neutral-600">nothing declared</p>
		}
		for _, feed := range feeds {
			<div>
				<p class="text-sm">
					<span class="font-mono font-medium">{ feed.Key }</span>
					<span class="text-gray-400 dark:text-neutral-600">· { rowCount(feed.Rows) } · match { strconv.Itoa(feed.Match) } · rules { strconv.Itoa(feed.Rules) }</span>
				</p>
				if len(feed.Last) == 0 {
					<p class="text-xs text-gray-400 dark:text-neutral-600">no rows in this match yet</p>
				} else {
					<pre class={ adminPre + " mt-1 max-h-64" }>{ feedText(feed.Last) }</pre>
				}
			</div>
		}
		if len(states) > 0 {
			<div>
				<p class="mb-1 text-xs text-gray-400 dark:text-neutral-600">shared state</p>
				<pre class={ adminPre + " max-h-64" }>{ stateText(states) }</pre>
			</div>
		}
	</section>
}

// AdminVersions lists the newest versions with their size, and a restore
// button for every version except the current one.
templ AdminVersions(versions []sqlc.SiteVersion, currentID int64, csrf string) {
	<section id="admin-versions" class={ adminCard + " p-0" }>
		<div class="flex items-baseline justify-between border-b border-gray-200 px-4 py-3 dark:border-neutral-800">
			<p class={ adminLabel }>versions</p>
			<p class={ adminMuted }>bar is page size</p>
		</div>
		<ol class="max-h-[36rem] divide-y divide-gray-100 overflow-y-auto dark:divide-neutral-800">
			for _, version := range versions {
				<li class="flex items-center gap-3 px-4 py-2">
					<span class="w-10 shrink-0 font-mono text-xs text-gray-900 dark:text-neutral-100">v{ i64(version.ID) }</span>
					<span class="flex min-w-0 flex-1 flex-col gap-1">
						<span class="truncate text-xs text-gray-600 dark:text-neutral-400" title={ version.Reason }>{ dash(version.Reason) }</span>
						<span class="flex items-center gap-2">
							<span class="h-1.5 w-full max-w-40 overflow-hidden rounded-full bg-gray-100 dark:bg-neutral-800">
								<span class="block h-full bg-emerald-500" style={ width(versionSize(version), largestVersion(versions)) }></span>
							</span>
							<span class="font-mono text-[10px] text-gray-400 dark:text-neutral-600">{ short(versionSize(version)) } · { clock(version.CreatedAt) }</span>
						</span>
					</span>
					if version.ID != currentID {
						<form
							method="post"
							action={ "/admin/versions/" + i64(version.ID) + "/restore" }
							data-on:submit={ "@post('/admin/versions/" + i64(version.ID) + "/restore', {contentType: 'form'})" }
							data-indicator:_restoring
						>
							@csrfInput(csrf)
							<button
								type="submit"
								data-attr:disabled="$_restoring"
								title="restores this version's page and journal schema; newer feed rows stay but become invisible"
								class="cursor-pointer text-xs text-sky-700 underline-offset-2 hover:underline disabled:cursor-default disabled:opacity-50 dark:text-sky-400"
							>restore</button>
						</form>
					} else {
						<span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">current</span>
					}
				</li>
			}
		</ol>
	</section>
}
