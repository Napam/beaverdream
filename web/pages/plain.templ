package pages

import (
	"strconv"

	"github.com/Napam/beaverdream"
	"github.com/Napam/beaverdream/db/generated/sqlc"
	"github.com/Napam/beaverdream/lib/webmaster"
)

// PlainPage is the code-owned board. No model output reaches it, so it keeps
// working when the site has made itself unreadable.
templ PlainPage(posts []sqlc.Post) {
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>beaverdream (plain)</title>
			<link rel="icon" type="image/svg+xml" href={ beaverdream.StaticRootPath("static/assets/beaver.svg") }/>
			<link rel="stylesheet" id="tailwindcss" href={ beaverdream.StaticRootPath("static/tailwind.css") }/>
		</head>
		<body class="min-h-dvh bg-gray-100 text-gray-800 dark:bg-neutral-950 dark:text-neutral-300">
			<div class="mx-auto w-full max-w-3xl px-4 py-8">
				<header class="mb-6 flex items-baseline justify-between gap-4">
					<h1 class="text-lg font-semibold tracking-tight text-gray-900 dark:text-neutral-100">beaverdream</h1>
					<a class="text-xs text-gray-400 hover:text-gray-600 dark:text-neutral-600 dark:hover:text-neutral-400" href="/">the real thing</a>
				</header>
				if len(posts) == 0 {
					<p class="text-sm text-gray-400 dark:text-neutral-600">no posts yet</p>
				}
				<ol class="flex flex-col">
					for _, post := range posts {
						<li class="border-t border-gray-300 py-3 first:border-t-0 dark:border-neutral-800">
							<div class="flex items-baseline gap-2 text-xs">
								<span class="font-semibold text-emerald-700 dark:text-emerald-400">
									if post.Author == "" {
										anon
									} else {
										{ post.Author }
									}
								</span>
								<span class="font-mono text-gray-400 dark:text-neutral-600">
									#{ strconv.FormatInt(post.ID, 10) } · { webmaster.FormatWhen(post.CreatedAt) }
								</span>
							</div>
							<p class="mt-1 text-sm whitespace-pre-wrap">{ post.Body }</p>
						</li>
					}
				</ol>
			</div>
		</body>
	</html>
}
