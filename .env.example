# Copy to .env to change a setting: cp .env.example .env
# Nothing here is required. With no .env, `task dev` runs against the mock model
# (start it with `task dev.mock-llm`).
# `task` loads .env. Taskfile env and shell variables win over it.
# A binary started by hand reads only its environment, not this file.

# --- Database ---
# Creates the tables on start. `task` already sets it. Default: false.
DB_MIGRATE_ON_START=true

# --- Real model (leave commented to use the mock) ---
# OpenAI-compatible endpoint with tool calls. Default: the mock on :6701.
# OPENAI_BASE_URL=https://your-endpoint.example.com/v1
# Model id. Default: mock-model.
# OPENAI_MODEL=your-model-name
# Bearer key. Default: empty, no Authorization header.
# OPENAI_API_KEY=sk-your-key-here
# Reasoning effort, such as low or high. Default: empty, provider decides.
# OPENAI_REASONING_EFFORT=
# Session header for the OpenCode gateway, used only for opencode.ai URLs.
# Default: random per start.
# OPENCODE_SESSION_ID=
# Tool rounds one turn may use. Each round is a paid request. Default: 3.
# MUTATION_ROUNDS=3

# --- Optional ---
# Admin password. Default: a new random one, printed in the log each start.
# ADMIN_PASSWORD=change-me
# SQLite file. Default: ./data/sqlite.db.
# DB_PATH=./data/sqlite.db
# Admin port, must differ from PORT. Default: PORT+1 (6931 for a bare binary).
# ADMIN_PORT=
# Public admin URL behind a proxy. Default: unset.
# ADMIN_URL=https://admin.example.com
# Serve HTTPS. Set both or neither. Default: unset, plain HTTP.
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# --- Bare binary only (the Taskfile sets these and wins over .env) ---
# Bind address. Default: localhost. `task` uses 0.0.0.0.
# HOST=localhost
# Board port. Default: 6930.
# PORT=6930
