# Copy to .env to change a setting: cp .env.example .env
#
# Nothing here is required. With no .env, `task dev` runs against the mock
# model (start it with `task dev.mock-llm`).
#
# `task` loads .env. Taskfile env and shell variables win over it.
# A binary started by hand reads only its environment, not this file.
#
# Lines starting with `#VAR=` are settings left at their default. Remove the
# `#` to set one. Lines starting with `# ` are notes.


# ==== Ports and public URLs ==================================================

# Bind address for both listeners. Default: localhost. `task` uses 0.0.0.0.
#HOST=localhost

# Management plane: login, invites, lobby and admin. Default: 6930.
#APP_PORT=6930

# Worlds serve under /worlds/{slug}. Default: 6932.
#PLAY_PORT=6932

# Public origins, usually subdomains of one registrable domain. Set both to
# `https` to enable secure cookie mode; one `https` plus one `http` or empty is
# refused at startup. Leaving both empty keeps the LAN cookie behavior and
# builds the origins from the request host and ports. Trailing `/` is trimmed.
#APP_URL=https://app.example.com
#PLAY_URL=https://play.example.com


# ==== Storage ================================================================

# Registry SQLite file. Default: ./data/registry.db.
#REGISTRY_PATH=./data/registry.db

# One <world-id>.db per world. Default: ./data/worlds.
#WORLDS_DIR=./data/worlds


# ==== Accounts, sessions and worlds ==========================================

# Bootstrap admin password, written on every start. Default: a new random one,
# printed in the log each start. Change it and restart to rotate.
#ADMIN_PASSWORD=change-me

# App session lifetime. Default: 168h (7 days).
#APP_SESSION_TTL=168h

# Play session lifetime. Default: 0 (no expiry).
#PLAY_SESSION_TTL=0

# One-time app-to-play handoff lifetime. Default: 1m.
#HANDOFF_TTL=1m

# Concurrent model turns across all worlds. Default: 1.
#MODEL_CONCURRENCY=1

# Close a world with no subscribers, queued posts or running turn. Default:
# 15m. 0 never unloads.
#WORLD_IDLE_TIMEOUT=15m


# ==== Daily token budgets (UTC day, 0 = unlimited) ===========================

# Per identity. Default: 1000000. A turn can reach about 200k prompt tokens
# before compaction, so a lower limit allows about one turn a day.
#DAILY_TOKENS_IDENTITY=1000000

# Across every identity. Default: 5000000.
#DAILY_TOKENS_GLOBAL=5000000


# ==== Real model (leave commented to use the mock) ===========================

# OpenAI-compatible endpoint with tool calls. Default: the mock on :6701.
#OPENAI_BASE_URL=https://your-endpoint.example.com/v1

# Model id. Default: mock-model.
#OPENAI_MODEL=your-model-name

# Bearer key. Default: empty, no Authorization header.
#OPENAI_API_KEY=sk-your-key-here

# Reasoning effort, such as low or high. Default: empty, provider decides.
#OPENAI_REASONING_EFFORT=

# Session header for the OpenCode gateway, used only for opencode.ai URLs.
# Default: random per start.
#OPENCODE_SESSION_ID=

# Tool rounds one turn may use. Each round is a paid request. Default: 25.
#TURN_MAX_ROUNDS=25

# Backstop for one whole turn. Default: 1h.
#TURN_TIMEOUT=1h


# ==== Optional ===============================================================

# Serve HTTPS on both listeners. Set both or neither; setting them turns on
# secure cookie mode. Default: unset, plain HTTP.
#TLS_CERT_FILE=/path/to/cert.pem
#TLS_KEY_FILE=/path/to/key.pem


# ==== Limits (fit these to the model and provider) ===========================

# One completion, in tokens. It bounds one whole-field write; a larger page
# still grows through edits.
#LLM_MAX_OUTPUT_TOKENS=250000

# Prompt budget in estimated tokens (four runes each): transcript plus page.
# Past it the history is compacted. Fit it to the model's context window.
#COMPACT_AT_PROMPT_TOKENS=200000

# CSS and HTML are capped at two thirds of the prompt budget above, in bytes,
# so a full page still leaves room to compact the history into it.

# How long the model stream may go quiet before the round is retried. Setting
# it uses one value for every phase. Zero turns the idle check off.
#LLM_IDLE_TIMEOUT=3m
